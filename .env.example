# Supabase (wajib untuk fitur dinamis; situs tetap bisa di-build tanpa ini dengan empty state)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hanya dipakai di server (Service Role / Secret) — untuk provisioning admin awal & operasi privat.
# JANGAN PERNAH mengekspos ke browser / commit ke Git. Jangan pakai key ini di kode client.
SUPABASE_SERVICE_ROLE_KEY=

# URL publik situs (untuk Auth redirect & SEO). Contoh: https://karangtaruna-waeura.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
