# Admin Karang Taruna Desa Waeura — SATU project Supabase yang sama dengan website public.
# JANGAN memasukkan nilai asli ke file ini. Salin menjadi admin/.env.local (diabaikan Git).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# JANGAN menambahkan SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY di sini
# atau di Vercel. Key server-only hanya dipakai provisioning di laptop via root scripts/.

# URL aplikasi admin (Auth redirect & metadata). Lokal: http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Opsional: tautan "Lihat situs publik" di sidebar (default: domain produksi public).
# NEXT_PUBLIC_PUBLIC_SITE_URL=https://webkarangtaruna.vercel.app
